{
  "name": "@glass-ui/core",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && vue-tsc -p tsconfig.build.json",
    "preview": "vite preview"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/es/index.js"
    },
    "./styles": {
      "types": "./dist/types/styles/index.d.ts",
      "default": "./dist/es/styles/index.js"
    },
    "./*/style.css": "./dist/es/*/style.css",
    "./*": {
      "types": "./dist/types/components/*/index.d.ts",
      "default": "./dist/es/*/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/json": "^2.2.525",
    "@iconify/utils": "^3.1.4",
    "@unocss/preset-wind4": "^66.10.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass-embedded": "^1.104.1",
    "typescript": "~6.0.2",
    "unocss": "^66.10.0",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
